{
  "name": "@sandbaseai/dsh-plugin-password-strength",
  "description": "DSH Cordis plugin: Check password strength and get improvement suggestions.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandbaseai/dsh-kit.git",
    "directory": "packages/password-strength"
  },
